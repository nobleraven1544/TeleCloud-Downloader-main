# TeleCloud-Downloader — Environment Variables
# Copy to Railway project variables (or use the Template). Required ones have no default.

# ── REQUIRED ──────────────────────────────────────────────
DOWNLOADER_BOT_TOKEN=            # @BotFather token
ADMIN_ID=                        # your Telegram numeric user_id

# ── Local Bot API (enables 2GB uploads) ───────────────────
TELEGRAM_API_ID=                 # my.telegram.org api_id
TELEGRAM_API_HASH=               # my.telegram.org api_hash

# ── Database ──────────────────────────────────────────────
# Leave empty → local SQLite fallback (no extra service needed)
DATABASE_URL=

# ── Registration & quotas ─────────────────────────────────
REGISTRATION_OPEN=false          # true = anyone can /start self-register
GITHUB_DEFAULT_REPO=             # owner/repo fallback for GitHub uploads
MAX_DAILY_FILES=20
MAX_DAILY_BYTES=5368709120       # 5 GB
MAX_MONTHLY_FILES=100
MAX_MONTHLY_BYTES=21474836480    # 20 GB

# ── Optional integrations ────────────────────────────────
DRIVE_FOLDER_ID=                 # Google Drive folder for Drive uploads
COLAB_URL=                       # Colab notebook URL shown during Drive onboarding
YT_PROXY=                        # optional proxy for yt-dlp
PUBLIC_BASE_URL=                 # public base for S3-backed links

# ── S3 / Railway Bucket (auto-injected by Railway) ────────
# ACCESS_KEY_ID / ACCESS_KEY_SECRET / BUCKET / ENDPOINT / REGION
# are provided automatically when you attach a Railway Volume/Bucket.
